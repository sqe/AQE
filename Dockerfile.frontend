# Use the official unprivileged Nginx image for the static terminal UI.
FROM nginxinc/nginx-unprivileged:alpine

# Copy the frontend application files into the default Nginx webroot
# The entry point will be app.jsx, which the canvas environment will render.
# In a standard React build, this would contain the compiled index.html and assets.
COPY --chown=101:101 frontend/ /usr/share/nginx/html/
COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf

# The unprivileged image listens on 8080.
EXPOSE 8080
